/// Singleton CMS for `/exams` (Quiz) sidebar guide — DEC-044.
model ExamGuideConfig {
  id          String   @id @db.VarChar(32)
  title       String   @db.VarChar(200)
  /// Ordered steps: `[{ id: string, text: string }]`.
  items       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("ExamGuideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("exam_guide_configs")
}

/// Guest-exam MCQ row. Named ExamQuestion so it does not collide with bank `Question` (DEC-039).
model ExamQuestion {
  id            String  @id @default(uuid()) @db.Uuid
  examId        String  @map("exam_id") @db.Uuid
  questionText  String  @map("question_text")
  /// Exactly four option strings [A, B, C, D].
  options       Json
  correctAnswer String  @map("correct_answer") @db.VarChar(1000)
  explanation   String?
  sortOrder     Int     @default(0) @map("sort_order")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, sortOrder])
  @@map("exam_questions")
}

model ExamAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  examId       String   @map("exam_id") @db.Uuid
  /// Set when submitter is authenticated (or claimed after register).
  userId       String?  @map("user_id") @db.Uuid
  userName     String   @map("user_name") @db.VarChar(120)
  score        Int
  correctCount Int      @map("correct_count")
  wrongCount   Int      @map("wrong_count")
  /// Map of questionId → selected option text (or empty if skipped).
  userAnswers  Json     @map("user_answers")
  /// Wall-clock seconds from client start to submit (informational).
  elapsedSeconds Int?   @map("elapsed_seconds")
  timedOut     Boolean  @default(false) @map("timed_out")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([examId, submittedAt(sort: Desc)])
  @@index([userId, submittedAt(sort: Desc)])
  @@map("exam_attempts")
}

/// Lightweight categories for guest Model Tests only (not bank taxonomy).
model ModelTestCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modelTests ModelTest[]

  @@map("model_test_categories")
}

/// Public guest Model Tests — parallel to Exam (DEC-039) with preamble-aware Excel import.
/// Does not reuse bank `Question` or guest `Exam` tables.
model ModelTest {
  id                String   @id @default(uuid()) @db.Uuid
