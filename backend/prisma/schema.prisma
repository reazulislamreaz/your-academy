// Your Academy — PostgreSQL schema (source of truth via migrations)
// See docs/05-database-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum DocumentVisibility {
  PUBLIC
  AUTHENTICATED
  PREMIUM
}

enum MediaResourceType {
  IMAGE
  RAW
  VIDEO
  AUTO
}

enum MediaDeliveryType {
  UPLOAD
  PRIVATE
  AUTHENTICATED
}

enum BrowsingSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Practice / quiz / model-test products (DEC-023).
enum PracticeSetKind {
  DAILY_QUIZ
  SUBJECT_QUIZ
  TOPIC_QUIZ
  MODEL_TEST
  PREVIOUS_YEAR_SET
}

enum PracticeSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PracticeAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// Admin Excel/CSV bulk upload lifecycle (DEC-024).
enum QuestionUploadStatus {
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  ARCHIVED
}

enum QuestionImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
}

/// Learner platform events for admin activity analytics (Phase 1). No secrets.
enum LearningActivityType {
  LOGIN
  LOGOUT
  QUESTION_ATTEMPT
  PRACTICE_START
  PRACTICE_SUBMIT
  BOOKMARK_QUESTION
  BOOKMARK_DOCUMENT
  DOCUMENT_VIEW
}

/// DEC-029 — Support messaging
enum SupportConversationStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum SupportSenderType {
  USER
  GUEST
  ADMIN
  SYSTEM
}

enum SupportMessageKind {
  TEXT
  ATTACHMENT
  SYSTEM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(120)
  whatsappNumber String     @unique @map("whatsapp_number") @db.VarChar(32)
  email          String?    @unique @db.VarChar(255)
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  avatarAssetId  String?    @unique @map("avatar_asset_id") @db.Uuid
  trialStartedAt DateTime   @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt    DateTime   @map("trial_ends_at") @db.Timestamptz(3)
  /// Root category IDs chosen during onboarding (max 3 enforced in service).
  preferredCategoryIds String[]  @default([]) @map("preferred_category_ids") @db.Uuid
  lastQuestionId       String?   @map("last_question_id") @db.Uuid
  lastQuestionFilterQs String?   @map("last_question_filter_qs") @db.VarChar(512)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  avatarAsset         MediaAsset?         @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  uploadedAssets      MediaAsset[]        @relation("UploadedBy")
  authSessions        AuthSession[]
  createdQuestions    Question[]          @relation("QuestionCreator")
  lastQuestion        Question?           @relation("UserLastQuestion", fields: [lastQuestionId], references: [id], onDelete: SetNull)
  questionBookmarks   QuestionBookmark[]
  documentBookmarks   DocumentBookmark[]
  bookmarkCollections BookmarkCollection[]
  questionAttempts    QuestionAttempt[]
  practiceAttempts    PracticeAttempt[]
  createdPracticeSets PracticeSet[]       @relation("PracticeSetCreator")
  questionUploadBatches QuestionUploadBatch[]
  browsingSessions    BrowsingSession[]
  subscriptions       UserSubscription[]
  createdNews         News[]              @relation("NewsCreator")
  createdDocuments    Document[]          @relation("DocumentCreator")
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  learningActivityEvents LearningActivityEvent[]
  supportConversationsAsUser   SupportConversation[] @relation("SupportConversationUser")
  supportConversationsAssigned SupportConversation[] @relation("SupportConversationAssignee")
  supportMessagesSent          SupportMessage[]      @relation("SupportMessageSender")
  supportInternalNotes         SupportInternalNote[]
  linkedSupportGuestSessions   SupportGuestSession[] @relation("SupportGuestLinkedUser")

  @@index([status])
  @@index([trialEndsAt])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  familyId             String    @map("family_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId  String?   @map("replaced_by_session_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]     @relation("CategoryTree")
  questions        Question[]     @relation("QuestionCategory")
  subQuestions     Question[]     @relation("QuestionSubcategory")
  documents        Document[]
  attempts         QuestionAttempt[]
  practiceSets     PracticeSet[]  @relation("PracticeSetCategory")
  practiceSetTopics PracticeSet[] @relation("PracticeSetSubcategory")
  batchPlacementsAsCategory    QuestionUploadBatchPlacement[] @relation("BatchPlacementCategory")
  batchPlacementsAsSubcategory QuestionUploadBatchPlacement[] @relation("BatchPlacementSubcategory")

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(200)
  content        String
  explanation    String?
  categoryId     String         @map("category_id") @db.Uuid
  subcategoryId  String?        @map("subcategory_id") @db.Uuid
  difficulty     Difficulty     @default(MEDIUM)
  status         QuestionStatus @default(DRAFT)
  /// Govt-job track tags (e.g. bcs-prelim, bank, primary-teacher). Not real PYQ unless marked.
  examTags       String[]       @default([]) @map("exam_tags")
  /// Optional human-readable source note (e.g. "Demo — BCS-style practice").
  sourceNote     String?        @map("source_note") @db.VarChar(240)
  /// Excel `প্রশ্ন নং` / serial from the upload sheet.
  sourceSerial   String?        @map("source_serial") @db.VarChar(32)
  /// Exam year extracted from sheet (e.g. 2026) for public year filters.
  examYear       String?        @map("exam_year") @db.VarChar(16)
  /// Section heading that preceded this MCQ in the Excel sheet (first-column preamble rows).
  sectionTitle   String?        @map("section_title") @db.VarChar(500)
  /// SHA-256 of normalized question text for cross-file duplicate detection (DEC-024).
  contentHash    String?        @map("content_hash") @db.VarChar(64)
  uploadBatchId  String?        @map("upload_batch_id") @db.Uuid
  imageAssetId   String?        @map("image_asset_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  category    Category          @relation("QuestionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category?         @relation("QuestionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  imageAsset  MediaAsset?       @relation("QuestionImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  uploadBatch QuestionUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  lastOpenedBy User[]           @relation("UserLastQuestion")
  options     QuestionOption[]
  bookmarks   QuestionBookmark[]
  attempts    QuestionAttempt[]
  practiceItems PracticeSetItem[]
  practiceAnswers PracticeAttemptAnswer[]
  importRows  QuestionImportRow[] @relation("ImportRowCreatedQuestion")

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId, status])
  @@index([subcategoryId, status])
  @@index([difficulty, status])
  @@index([examYear, status])
  @@index([examTags], type: Gin)
  @@index([contentHash])
  @@index([uploadBatchId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String  @db.VarChar(10)
  content    String
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  question              Question                 @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts              QuestionAttempt[]
  practiceAttemptAnswers PracticeAttemptAnswer[]

  @@index([questionId, sortOrder])
  /// Partial unique (migration): one is_correct=true row per question_id
  @@map("question_options")
}

/// Learner practice check — server stores correctness for personal analytics (DEC-022).
model QuestionAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String   @map("selected_option_id") @db.Uuid
  isCorrect        Boolean  @map("is_correct")
  categoryId       String   @map("category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, questionId, createdAt(sort: Desc)])
  @@map("question_attempts")
}

model News {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(220)
  summary      String?
  body         String
  coverAssetId String?   @map("cover_asset_id") @db.Uuid
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  coverAsset MediaAsset?    @relation("NewsCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("NewsCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents  NewsDocument[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("news")
}

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  title        String             @db.VarChar(200)
  description  String?
  mediaAssetId String             @map("media_asset_id") @db.Uuid
  categoryId   String?            @map("category_id") @db.Uuid
  visibility   DocumentVisibility @default(AUTHENTICATED)
  isPublished  Boolean            @default(false) @map("is_published")
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)

  mediaAsset MediaAsset         @relation("DocumentFile", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  newsLinks  NewsDocument[]
  bookmarks  DocumentBookmark[]

  @@index([isPublished])
  @@index([visibility])
  @@index([isPublished, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("documents")
}

model NewsDocument {
  newsId     String @map("news_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  news     News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([newsId, documentId])
  @@map("news_documents")
}

model MediaAsset {
  id               String            @id @default(uuid()) @db.Uuid
  publicId         String            @map("public_id") @db.VarChar(255)
  resourceType     MediaResourceType @map("resource_type")
  deliveryType     MediaDeliveryType @map("delivery_type")
  format           String?           @db.VarChar(32)
  bytes            Int
  mimeType         String            @map("mime_type") @db.VarChar(127)
  width            Int?
  height           Int?
  originalFilename String?           @map("original_filename") @db.VarChar(255)
  uploadedById     String?           @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  uploadedBy         User?               @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  userAvatar         User?               @relation("UserAvatar")
  questionImages     Question[]          @relation("QuestionImage")
  newsCovers         News[]              @relation("NewsCover")
  documents          Document[]          @relation("DocumentFile")
  supportAttachments SupportAttachment[]

  @@unique([publicId, resourceType])
  @@index([uploadedById])
  @@map("media_assets")
}

/// Learner-owned MCQ save folder (Facebook-style collection). Private per user.
model BookmarkCollection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks QuestionBookmark[]

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmark_collections")
}

model QuestionBookmark {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  /// Null = Saved Items (uncategorized). At most one folder per user+question (DEC-026).
  collectionId String?  @map("collection_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  collection BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, collectionId, createdAt(sort: Desc)])
  @@index([collectionId])
  @@map("question_bookmarks")
}

model DocumentBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("document_bookmarks")
}

model BrowsingSession {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  startedAt        DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt  DateTime              @default(now()) @map("last_heartbeat_at") @db.Timestamptz(3)
  endedAt          DateTime?             @map("ended_at") @db.Timestamptz(3)
  accruedSeconds   Int                   @default(0) @map("accrued_seconds")
  clientInstanceId String?               @map("client_instance_id") @db.VarChar(64)
  userAgent        String?               @map("user_agent")
  status           BrowsingSessionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([status, lastHeartbeatAt(sort: Desc)])
  /// Partial unique (migration): one ACTIVE session per user_id
  @@map("browsing_sessions")
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(64)
  name          String   @db.VarChar(120)
  description   String?
  durationDays  Int      @map("duration_days")
  priceCents    Int      @default(0) @map("price_cents")
  currency      String   @default("USD") @db.Char(3)
  entitlements  Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  planId     String             @map("plan_id") @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime           @map("ends_at") @db.Timestamptz(3)
  canceledAt DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([endsAt])
  @@map("user_subscriptions")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  userSubscriptionId String        @map("user_subscription_id") @db.Uuid
  provider           String        @db.VarChar(64)
  providerRef        String        @map("provider_ref") @db.VarChar(255)
  amountCents        Int           @map("amount_cents")
  currency           String        @db.Char(3)
  status             PaymentStatus @default(PENDING)
  rawPayload         Json?         @map("raw_payload")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userSubscription UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Append-only learner activity for admin monitoring (no passwords/tokens/keystrokes).
model LearningActivityEvent {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  type              LearningActivityType
  occurredAt        DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  subjectCategoryId String?              @map("subject_category_id") @db.Uuid
  topicCategoryId   String?              @map("topic_category_id") @db.Uuid
  questionId        String?              @map("question_id") @db.Uuid
  practiceSetId     String?              @map("practice_set_id") @db.Uuid
  practiceAttemptId String?              @map("practice_attempt_id") @db.Uuid
  meta              Json                 @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([type, occurredAt(sort: Desc)])
  @@index([subjectCategoryId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("learning_activity_events")
}

/// Timed or untimed practice packs: daily quiz, subject quiz, model test, etc. (DEC-023).
model PracticeSet {
  id                   String            @id @default(uuid()) @db.Uuid
  title                String            @db.VarChar(200)
  slug                 String            @unique @db.VarChar(220)
  description          String?
  kind                 PracticeSetKind
  status               PracticeSetStatus @default(DRAFT)
  durationSeconds      Int?              @map("duration_seconds")
  marksPerCorrect      Float             @default(1) @map("marks_per_correct")
  negativeMarkPerWrong Float             @default(0) @map("negative_mark_per_wrong")
  categoryId           String?           @map("category_id") @db.Uuid
  subcategoryId        String?           @map("subcategory_id") @db.Uuid
  examTag              String?           @map("exam_tag") @db.VarChar(64)
  isDaily              Boolean           @default(false) @map("is_daily")
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(3)
  createdById          String?           @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category?          @relation("PracticeSetCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Category?          @relation("PracticeSetSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("PracticeSetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       PracticeSetItem[]
  attempts    PracticeAttempt[]

  @@index([status, kind, publishedAt(sort: Desc)])
  @@index([examTag, status])
  @@index([categoryId, status])
  @@index([isDaily, status])
  @@map("practice_sets")
}

model PracticeSetItem {
  id            String @id @default(uuid()) @db.Uuid
  practiceSetId String @map("practice_set_id") @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  sortOrder     Int    @default(0) @map("sort_order")

  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSetId, questionId])
  @@index([practiceSetId, sortOrder])
  @@map("practice_set_items")
}

model PracticeAttempt {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  practiceSetId String                @map("practice_set_id") @db.Uuid
  status        PracticeAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz(3)
  score         Float?                
  maxScore      Float?                @map("max_score")
  correctCount  Int?                  @map("correct_count")
  wrongCount    Int?                  @map("wrong_count")
  skippedCount  Int?                  @map("skipped_count")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSet PracticeSet             @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  answers     PracticeAttemptAnswer[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([practiceSetId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("practice_attempts")
}

model PracticeAttemptAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  attemptId        String  @map("attempt_id") @db.Uuid
  questionId       String  @map("question_id") @db.Uuid
  selectedOptionId String? @map("selected_option_id") @db.Uuid
  isCorrect        Boolean? @map("is_correct")

  attempt        PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("practice_attempt_answers")
}

/// Excel/CSV bulk upload batch with unique identity + file hash (DEC-024).
model QuestionUploadBatch {
  id                 String               @id @default(uuid()) @db.Uuid
  batchCode          String               @unique @map("batch_code") @db.VarChar(80)
  displayName        String               @map("display_name") @db.VarChar(200)
  description        String?
  originalFilename   String               @map("original_filename") @db.VarChar(255)
  mimeType           String               @map("mime_type") @db.VarChar(127)
  fileSha256         String               @map("file_sha256") @db.VarChar(64)
  storagePath        String               @map("storage_path") @db.VarChar(500)
  status             QuestionUploadStatus @default(VALIDATED)
  totalRows          Int                  @default(0) @map("total_rows")
  validCount         Int                  @default(0) @map("valid_count")
  invalidCount       Int                  @default(0) @map("invalid_count")
  duplicateCount     Int                  @default(0) @map("duplicate_count")
  importedCount      Int                  @default(0) @map("imported_count")
  skippedCount       Int                  @default(0) @map("skipped_count")
  failedCount        Int                  @default(0) @map("failed_count")
  subjectHint        String?              @map("subject_hint") @db.VarChar(120)
  topicHint          String?              @map("topic_hint") @db.VarChar(120)
  examCategoryHint   String?              @map("exam_category_hint") @db.VarChar(120)
  /// First-column text above the MCQ header row (shown before questions on the set page).
  sheetPreamble      String?              @map("sheet_preamble")
  /// Primary exam year for this collection (public year filter).
  examYear           String?              @map("exam_year") @db.VarChar(16)
  duplicateFileBatchId String?            @map("duplicate_file_batch_id") @db.Uuid
  errorMessage       String?              @map("error_message")
  uploadedById       String               @map("uploaded_by_id") @db.Uuid
  importedAt         DateTime?            @map("imported_at") @db.Timestamptz(3)
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  rows       QuestionImportRow[]
  questions  Question[]
  placements QuestionUploadBatchPlacement[]

  @@index([status, createdAt(sort: Desc)])
  @@index([fileSha256])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([examYear])
  @@map("question_upload_batches")
}

/// Multi-placement: one Excel/batch can appear under several subcategories (homepage / bank filters).
model QuestionUploadBatchPlacement {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  subcategoryId String   @map("subcategory_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch       QuestionUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category    Category            @relation("BatchPlacementCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Category            @relation("BatchPlacementSubcategory", fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([batchId, subcategoryId])
  @@index([subcategoryId, batchId])
  @@index([categoryId, batchId])
  @@map("question_upload_batch_placements")
}

model QuestionImportRow {
  id                 String                  @id @default(uuid()) @db.Uuid
  batchId            String                  @map("batch_id") @db.Uuid
  rowNumber          Int                     @map("row_number")
  status             QuestionImportRowStatus
  contentHash        String?                 @map("content_hash") @db.VarChar(64)
  /// Excel `প্রশ্ন নং` value (display serial).
  serial             String?                 @db.VarChar(32)
  questionText       String                  @map("question_text")
  optionA            String?                 @map("option_a")
  optionB            String?                 @map("option_b")
  optionC            String?                 @map("option_c")
  optionD            String?                 @map("option_d")
  correctAnswer      String?                 @map("correct_answer") @db.VarChar(1)
  explanation        String?
  subjectName        String?                 @map("subject_name") @db.VarChar(120)
  topicName          String?                 @map("topic_name") @db.VarChar(120)
  difficulty         String?                 @db.VarChar(16)
  examCategory       String?                 @map("exam_category") @db.VarChar(120)
  examYear           String?                 @map("exam_year") @db.VarChar(32)
  source             String?                 @db.VarChar(240)
  sectionTitle       String?                 @map("section_title") @db.VarChar(500)
  errorMessage       String?                 @map("error_message") @db.VarChar(500)
  existingQuestionId String?                 @map("existing_question_id") @db.Uuid
  createdQuestionId  String?                 @map("created_question_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  batch            QuestionUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdQuestion  Question?           @relation("ImportRowCreatedQuestion", fields: [createdQuestionId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([contentHash])
  @@map("question_import_rows")
}

/// Guest visitor identity for support chat (DEC-029). Opaque token hashed in DB.
model SupportGuestSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  name           String    @db.VarChar(120)
  whatsappNumber String    @map("whatsapp_number") @db.VarChar(32)
  linkedUserId   String?   @map("linked_user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  linkedUser    User?                 @relation("SupportGuestLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  conversations SupportConversation[]

  @@index([whatsappNumber])
  @@index([linkedUserId])
  @@index([expiresAt])
  @@map("support_guest_sessions")
}

model SupportConversation {
  id                 String                    @id @default(uuid()) @db.Uuid
  status             SupportConversationStatus @default(OPEN)
  subject            String?                   @db.VarChar(200)
  userId             String?                   @map("user_id") @db.Uuid
  guestSessionId     String?                   @map("guest_session_id") @db.Uuid
  guestName          String?                   @map("guest_name") @db.VarChar(120)
  guestWhatsapp      String?                   @map("guest_whatsapp") @db.VarChar(32)
  assignedAdminId    String?                   @map("assigned_admin_id") @db.Uuid
  lastMessageAt      DateTime?                 @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?                   @map("last_message_preview") @db.VarChar(280)
  userUnreadCount    Int                       @default(0) @map("user_unread_count")
  adminUnreadCount   Int                       @default(0) @map("admin_unread_count")
  closedAt           DateTime?                 @map("closed_at") @db.Timestamptz(3)
  archivedAt         DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                 @relation("SupportConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  guestSession SupportGuestSession?  @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  assignedAdmin User?                @relation("SupportConversationAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]
  notes        SupportInternalNote[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([userId, status])
  @@index([guestSessionId])
  @@index([assignedAdminId])
  @@index([guestWhatsapp])
  @@map("support_conversations")
}

model SupportMessage {
  id              String             @id @default(uuid()) @db.Uuid
  conversationId  String             @map("conversation_id") @db.Uuid
  senderType      SupportSenderType  @map("sender_type")
  senderUserId    String?            @map("sender_user_id") @db.Uuid
  clientMessageId String?            @map("client_message_id") @db.VarChar(64)
  kind            SupportMessageKind @default(TEXT)
  body            String?            @db.VarChar(8000)
  deliveredAt     DateTime?          @map("delivered_at") @db.Timestamptz(3)
  readAt          DateTime?          @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?                @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, id])
  @@index([senderUserId])
  @@map("support_messages")
}

model SupportAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  mediaAssetId     String   @map("media_asset_id") @db.Uuid
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  bytes            Int

  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([mediaAssetId])
  @@map("support_attachments")
}

model SupportInternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorAdminId  String   @map("author_admin_id") @db.Uuid
  body           String   @db.VarChar(4000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorAdmin  User                @relation(fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([authorAdminId])
  @@map("support_internal_notes")
}
