  categoryId        String?  @map("category_id") @db.Uuid
  totalQuestions    Int      @map("total_questions")
  durationInMinutes Int      @map("duration_in_minutes")
  isPublished       Boolean  @default(true) @map("is_published")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  ModelTestCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("ModelTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions ModelTestQuestion[]
  attempts  ModelTestAttempt[]

  @@index([isPublished, createdAt(sort: Desc)])
  @@index([examYear])
  @@index([categoryId])
  @@map("model_tests")
}

model ModelTestQuestion {
  id            String  @id @default(uuid()) @db.Uuid
  modelTestId   String  @map("model_test_id") @db.Uuid
  questionText  String  @map("question_text")
  /// Exactly four option strings [A, B, C, D].
  options       Json
