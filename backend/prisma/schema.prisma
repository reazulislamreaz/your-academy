  explanation   String?
  sortOrder     Int     @default(0) @map("sort_order")

  modelTest ModelTest @relation(fields: [modelTestId], references: [id], onDelete: Cascade)

  @@index([modelTestId, sortOrder])
  @@map("model_test_questions")
}

model ModelTestAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  modelTestId   String   @map("model_test_id") @db.Uuid
  /// Set when submitter is authenticated (or claimed after register).
  userId        String?  @map("user_id") @db.Uuid
  userName      String   @map("user_name") @db.VarChar(120)
  score         Int
  correctCount  Int      @map("correct_count")
  wrongCount    Int      @map("wrong_count")
  skippedCount  Int      @default(0) @map("skipped_count")
  /// Map of questionId → selected option text (or empty if skipped).
  userAnswers   Json     @map("user_answers")
  elapsedSeconds Int?    @map("elapsed_seconds")
  timedOut      Boolean  @default(false) @map("timed_out")
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  modelTest ModelTest @relation(fields: [modelTestId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([modelTestId, submittedAt(sort: Desc)])
  @@index([userId, submittedAt(sort: Desc)])
  @@map("model_test_attempts")
}

/// Singleton CMS for `/model-test` sidebar guide ("মডেল টেস্ট কীভাবে দিবেন") — DEC-043.
model ModelTestGuideConfig {
  id          String   @id @db.VarChar(32)
  title       String   @db.VarChar(200)
  /// Ordered steps: `[{ id: string, text: string }]`.
  items       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("ModelTestGuideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("model_test_guide_configs")
}

/// Timed or untimed practice packs: daily quiz, subject quiz, model test, etc. (DEC-023).
model PracticeSet {
  id                   String            @id @default(uuid()) @db.Uuid
  title                String            @db.VarChar(200)
  slug                 String            @unique @db.VarChar(220)
  description          String?
  kind                 PracticeSetKind
  status               PracticeSetStatus @default(DRAFT)
  durationSeconds      Int?              @map("duration_seconds")
  marksPerCorrect      Float             @default(1) @map("marks_per_correct")
  negativeMarkPerWrong Float             @default(0) @map("negative_mark_per_wrong")
  /// Optional pass threshold (0–100). Null = no pass/fail grade.
  passMarkPercent      Float?            @map("pass_mark_percent")
  categoryId           String?           @map("category_id") @db.Uuid
  subcategoryId        String?           @map("subcategory_id") @db.Uuid
  examTag              String?           @map("exam_tag") @db.VarChar(64)
  isDaily              Boolean           @default(false) @map("is_daily")
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(3)
  createdById          String?           @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category?          @relation("PracticeSetCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Category?          @relation("PracticeSetSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("PracticeSetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       PracticeSetItem[]
  attempts    PracticeAttempt[]

  @@index([status, kind, publishedAt(sort: Desc)])
  @@index([examTag, status])
  @@index([categoryId, status])
  @@index([isDaily, status])
  @@map("practice_sets")
}

model PracticeSetItem {
  id            String @id @default(uuid()) @db.Uuid
  practiceSetId String @map("practice_set_id") @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  sortOrder     Int    @default(0) @map("sort_order")

  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSetId, questionId])
  @@index([practiceSetId, sortOrder])
  @@map("practice_set_items")
}

model PracticeAttempt {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  practiceSetId  String                @map("practice_set_id") @db.Uuid
  status         PracticeAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt    DateTime?             @map("submitted_at") @db.Timestamptz(3)
  /// Attempt-scoped timer (null = untimed). Set at start; used for deadline instead of PracticeSet.durationSeconds.
  timerSeconds   Int?                  @map("timer_seconds")
  /// Wall-clock seconds from start to submit (capped by duration when timed).
  elapsedSeconds Int?                  @map("elapsed_seconds")
  score          Float?
  maxScore       Float?                @map("max_score")
  percentScore   Float?                @map("percent_score")
  passed         Boolean?
  correctCount   Int?                  @map("correct_count")
  wrongCount     Int?                  @map("wrong_count")
  skippedCount   Int?                  @map("skipped_count")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSet PracticeSet             @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  answers     PracticeAttemptAnswer[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([practiceSetId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, submittedAt(sort: Desc)])
  @@map("practice_attempts")
}

model PracticeAttemptAnswer {
  id               String    @id @default(uuid()) @db.Uuid
  attemptId        String    @map("attempt_id") @db.Uuid
  questionId       String    @map("question_id") @db.Uuid
  selectedOptionId String?   @map("selected_option_id") @db.Uuid
  isCorrect        Boolean?  @map("is_correct")
  /// Learner flag for later review (does not affect scoring).
  markedForReview  Boolean   @default(false) @map("marked_for_review")
  /// Last progress save / final answer time (mid-attempt autosave).
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz(3)
  /// Snapshots so review survives later MCQ edits (DEC-035).
  questionTitleSnapshot    String? @map("question_title_snapshot") @db.VarChar(200)
  questionContentSnapshot  String? @map("question_content_snapshot")
  explanationSnapshot      String? @map("explanation_snapshot")
  optionsSnapshot          Json?   @map("options_snapshot")

  attempt        PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("practice_attempt_answers")
}

/// Excel/CSV bulk upload batch with unique identity + file hash (DEC-024).
model QuestionUploadBatch {
  id                 String               @id @default(uuid()) @db.Uuid
  batchCode          String               @unique @map("batch_code") @db.VarChar(80)
  displayName        String               @map("display_name") @db.VarChar(200)
  description        String?
  originalFilename   String               @map("original_filename") @db.VarChar(255)
  mimeType           String               @map("mime_type") @db.VarChar(127)
  fileSha256         String               @map("file_sha256") @db.VarChar(64)
  storagePath        String               @map("storage_path") @db.VarChar(500)
  status             QuestionUploadStatus @default(VALIDATED)
  totalRows          Int                  @default(0) @map("total_rows")
  validCount         Int                  @default(0) @map("valid_count")
  invalidCount       Int                  @default(0) @map("invalid_count")
  duplicateCount     Int                  @default(0) @map("duplicate_count")
  importedCount      Int                  @default(0) @map("imported_count")
  skippedCount       Int                  @default(0) @map("skipped_count")
  failedCount        Int                  @default(0) @map("failed_count")
  subjectHint        String?              @map("subject_hint") @db.VarChar(120)
  topicHint          String?              @map("topic_hint") @db.VarChar(120)
  examCategoryHint   String?              @map("exam_category_hint") @db.VarChar(120)
  /// First-column text above the MCQ header row (shown before questions on the set page).
  sheetPreamble      String?              @map("sheet_preamble")
  /// Primary exam year for this collection (public year filter; derived from questionDate when set).
  examYear           String?              @map("exam_year") @db.VarChar(16)
  /// Collection question date (newest / primary); used for public set sorting.
  questionDate       DateTime?            @map("question_date") @db.Timestamptz(3)
  duplicateFileBatchId String?            @map("duplicate_file_batch_id") @db.Uuid
  errorMessage       String?              @map("error_message")
  uploadedById       String               @map("uploaded_by_id") @db.Uuid
  importedAt         DateTime?            @map("imported_at") @db.Timestamptz(3)
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  rows       QuestionImportRow[]
  questions  Question[]
  placements QuestionUploadBatchPlacement[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, questionDate(sort: Desc), id(sort: Desc)])
  @@index([fileSha256])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([examYear])
  @@map("question_upload_batches")
}

/// Multi-placement: one Excel/batch can appear under several subcategories (homepage / bank filters).
model QuestionUploadBatchPlacement {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  subcategoryId String   @map("subcategory_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch       QuestionUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category    Category            @relation("BatchPlacementCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Category            @relation("BatchPlacementSubcategory", fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([batchId, subcategoryId])
  @@index([subcategoryId, batchId])
  @@index([categoryId, batchId])
  @@map("question_upload_batch_placements")
}

model QuestionImportRow {
  id                 String                  @id @default(uuid()) @db.Uuid
  batchId            String                  @map("batch_id") @db.Uuid
  rowNumber          Int                     @map("row_number")
  status             QuestionImportRowStatus
  contentHash        String?                 @map("content_hash") @db.VarChar(64)
  /// Excel `প্রশ্ন নং` value (display serial).
  serial             String?                 @db.VarChar(32)
  questionText       String                  @map("question_text")
  optionA            String?                 @map("option_a")
  optionB            String?                 @map("option_b")
  optionC            String?                 @map("option_c")
  optionD            String?                 @map("option_d")
  correctAnswer      String?                 @map("correct_answer") @db.VarChar(1)
  explanation        String?
  subjectName        String?                 @map("subject_name") @db.VarChar(120)
  topicName          String?                 @map("topic_name") @db.VarChar(120)
  difficulty         String?                 @db.VarChar(16)
  examCategory       String?                 @map("exam_category") @db.VarChar(120)
  examYear           String?                 @map("exam_year") @db.VarChar(32)
  /// Per-row question date from Excel / admin correction (ISO date stored as timestamptz).
  questionDate       DateTime?               @map("question_date") @db.Timestamptz(3)
  source             String?                 @db.VarChar(240)
  sectionTitle       String?                 @map("section_title") @db.VarChar(500)
  errorMessage       String?                 @map("error_message") @db.VarChar(500)
  existingQuestionId String?                 @map("existing_question_id") @db.Uuid
  createdQuestionId  String?                 @map("created_question_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  batch            QuestionUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdQuestion  Question?           @relation("ImportRowCreatedQuestion", fields: [createdQuestionId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([contentHash])
  @@map("question_import_rows")
}

/// Guest visitor identity for support chat (DEC-029). Opaque token hashed in DB.
model SupportGuestSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  name           String    @db.VarChar(120)
  whatsappNumber String    @map("whatsapp_number") @db.VarChar(32)
  linkedUserId   String?   @map("linked_user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  linkedUser    User?                 @relation("SupportGuestLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  conversations SupportConversation[]

  @@index([whatsappNumber])
  @@index([linkedUserId])
  @@index([expiresAt])
  @@map("support_guest_sessions")
}

model SupportConversation {
  id                 String                    @id @default(uuid()) @db.Uuid
  status             SupportConversationStatus @default(OPEN)
  subject            String?                   @db.VarChar(200)
  userId             String?                   @map("user_id") @db.Uuid
  guestSessionId     String?                   @map("guest_session_id") @db.Uuid
  guestName          String?                   @map("guest_name") @db.VarChar(120)
  guestWhatsapp      String?                   @map("guest_whatsapp") @db.VarChar(32)
  assignedAdminId    String?                   @map("assigned_admin_id") @db.Uuid
  lastMessageAt      DateTime?                 @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?                   @map("last_message_preview") @db.VarChar(280)
  userUnreadCount    Int                       @default(0) @map("user_unread_count")
  adminUnreadCount   Int                       @default(0) @map("admin_unread_count")
  closedAt           DateTime?                 @map("closed_at") @db.Timestamptz(3)
  archivedAt         DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?                 @relation("SupportConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  guestSession SupportGuestSession?  @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  assignedAdmin User?                @relation("SupportConversationAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]
  notes        SupportInternalNote[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([userId, status])
  @@index([guestSessionId])
  @@index([assignedAdminId])
  @@index([guestWhatsapp])
  @@map("support_conversations")
}

model SupportMessage {
  id              String             @id @default(uuid()) @db.Uuid
  conversationId  String             @map("conversation_id") @db.Uuid
  senderType      SupportSenderType  @map("sender_type")
  senderUserId    String?            @map("sender_user_id") @db.Uuid
  clientMessageId String?            @map("client_message_id") @db.VarChar(64)
  kind            SupportMessageKind @default(TEXT)
  body            String?            @db.VarChar(8000)
  deliveredAt     DateTime?          @map("delivered_at") @db.Timestamptz(3)
  readAt          DateTime?          @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?                @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@unique([conversationId, clientMessageId])
  /// Chronological thread order (UUID id alone is not time-ordered).
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderUserId])
  @@map("support_messages")
}

model SupportAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  mediaAssetId     String   @map("media_asset_id") @db.Uuid
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  bytes            Int

  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([mediaAssetId])
  @@map("support_attachments")
}

model SupportInternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorAdminId  String   @map("author_admin_id") @db.Uuid
  body           String   @db.VarChar(4000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorAdmin  User                @relation(fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([authorAdminId])
  @@map("support_internal_notes")
}

/// DEC-040 — Written Question Bank (descriptive / model-answer questions; parallel to Preli MCQ bank).
model WrittenQuestion {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(200)
  content        String
  modelAnswer    String?        @map("model_answer")
  marks          Decimal?       @map("marks") @db.Decimal(6, 2)
  categoryId     String         @map("category_id") @db.Uuid
  subcategoryId  String?        @map("subcategory_id") @db.Uuid
  status         QuestionStatus @default(DRAFT)
  examTags       String[]       @default([]) @map("exam_tags")
  sourceNote     String?        @map("source_note") @db.VarChar(240)
  sourceSerial   String?        @map("source_serial") @db.VarChar(32)
  examYear       String?        @map("exam_year") @db.VarChar(16)
  questionDate   DateTime?      @map("question_date") @db.Timestamptz(3)
  sectionTitle   String?        @map("section_title") @db.VarChar(500)
  contentHash    String?        @map("content_hash") @db.VarChar(64)
  uploadBatchId  String?        @map("upload_batch_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  category    Category            @relation("WrittenQuestionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category?           @relation("WrittenQuestionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("WrittenQuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  uploadBatch WrittenUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  importRows  WrittenImportRow[]  @relation("ImportRowCreatedWrittenQuestion")

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId, status])
  @@index([subcategoryId, status])
  @@index([examYear, status])
  @@index([status, questionDate(sort: Desc), id(sort: Desc)])
  @@index([questionDate(sort: Desc), status])
  @@index([examTags], type: Gin)
  @@index([contentHash])
  @@index([uploadBatchId])
  @@map("written_questions")
}

model WrittenUploadBatch {
  id                   String               @id @default(uuid()) @db.Uuid
  batchCode            String               @unique @map("batch_code") @db.VarChar(80)
  displayName          String               @map("display_name") @db.VarChar(200)
  description          String?
  originalFilename     String               @map("original_filename") @db.VarChar(255)
  mimeType             String               @map("mime_type") @db.VarChar(127)
  fileSha256           String               @map("file_sha256") @db.VarChar(64)
  storagePath          String               @map("storage_path") @db.VarChar(500)
  status               QuestionUploadStatus @default(VALIDATED)
  totalRows            Int                  @default(0) @map("total_rows")
  validCount           Int                  @default(0) @map("valid_count")
  invalidCount         Int                  @default(0) @map("invalid_count")
  duplicateCount       Int                  @default(0) @map("duplicate_count")
  importedCount        Int                  @default(0) @map("imported_count")
  skippedCount         Int                  @default(0) @map("skipped_count")
  failedCount          Int                  @default(0) @map("failed_count")
  subjectHint          String?              @map("subject_hint") @db.VarChar(120)
  topicHint            String?              @map("topic_hint") @db.VarChar(120)
  examCategoryHint     String?              @map("exam_category_hint") @db.VarChar(120)
  sheetPreamble        String?              @map("sheet_preamble")
  examYear             String?              @map("exam_year") @db.VarChar(16)
  questionDate         DateTime?            @map("question_date") @db.Timestamptz(3)
  duplicateFileBatchId String?              @map("duplicate_file_batch_id") @db.Uuid
  errorMessage         String?              @map("error_message")
  uploadedById         String               @map("uploaded_by_id") @db.Uuid
  importedAt           DateTime?            @map("imported_at") @db.Timestamptz(3)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy User                          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  rows       WrittenImportRow[]
  questions  WrittenQuestion[]
  placements WrittenUploadBatchPlacement[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, questionDate(sort: Desc), id(sort: Desc)])
  @@index([fileSha256])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([examYear])
  @@map("written_upload_batches")
}

model WrittenUploadBatchPlacement {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  subcategoryId String   @map("subcategory_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch       WrittenUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category    Category           @relation("WrittenBatchPlacementCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Category           @relation("WrittenBatchPlacementSubcategory", fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([batchId, subcategoryId])
  @@index([subcategoryId, batchId])
  @@index([categoryId, batchId])
  @@map("written_upload_batch_placements")
}

model WrittenImportRow {
  id                 String                  @id @default(uuid()) @db.Uuid
  batchId            String                  @map("batch_id") @db.Uuid
  rowNumber          Int                     @map("row_number")
  status             QuestionImportRowStatus
  contentHash        String?                 @map("content_hash") @db.VarChar(64)
  serial             String?                 @db.VarChar(32)
  questionText       String                  @map("question_text")
  modelAnswer        String?                 @map("model_answer")
  marks              Decimal?                @db.Decimal(6, 2)
  subjectName        String?                 @map("subject_name") @db.VarChar(120)
  topicName          String?                 @map("topic_name") @db.VarChar(120)
  examCategory       String?                 @map("exam_category") @db.VarChar(120)
  examYear           String?                 @map("exam_year") @db.VarChar(32)
  questionDate       DateTime?               @map("question_date") @db.Timestamptz(3)
  source             String?                 @db.VarChar(240)
  sectionTitle       String?                 @map("section_title") @db.VarChar(500)
  errorMessage       String?                 @map("error_message") @db.VarChar(500)
  existingQuestionId String?                 @map("existing_question_id") @db.Uuid
  createdQuestionId  String?                 @map("created_question_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  batch           WrittenUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdQuestion WrittenQuestion?   @relation("ImportRowCreatedWrittenQuestion", fields: [createdQuestionId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([contentHash])
  @@map("written_import_rows")
}

/// Topic Base Question Analysis upload batch (DEC-042). One-shot import; no row rejection.
model TopicUploadBatch {
  id               String             @id @default(uuid()) @db.Uuid
  batchCode        String             @unique @map("batch_code") @db.VarChar(80)
  displayName      String             @map("display_name") @db.VarChar(200)
  originalFilename String             @map("original_filename") @db.VarChar(255)
  fileSha256       String             @map("file_sha256") @db.VarChar(64)
  categoryId       String             @map("category_id") @db.Uuid
  subcategoryId    String             @map("subcategory_id") @db.Uuid
  /// Optional Level-3 Topic child category (DEC-042 three-level hierarchy).
  childCategoryId  String?            @map("child_category_id") @db.Uuid
  status           QuestionUploadStatus @default(COMPLETED)
  totalRows        Int                @default(0) @map("total_rows")
  importedCount    Int                @default(0) @map("imported_count")
  uploadedById     String             @map("uploaded_by_id") @db.Uuid
  importedAt       DateTime?          @map("imported_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  category      Category       @relation("TopicBatchCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Category       @relation("TopicBatchSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  childCategory Category?      @relation("TopicBatchChildCategory", fields: [childCategoryId], references: [id], onDelete: Restrict)
  questions     TopicQuestion[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, subcategoryId])
  @@index([childCategoryId])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@map("topic_upload_batches")
}

/// Topic Base MCQ (8-column Excel). Always imported; duplicates / soft gaps allowed.
model TopicQuestion {
  id               String           @id @default(uuid()) @db.Uuid
  batchId          String           @map("batch_id") @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  subcategoryId    String           @map("subcategory_id") @db.Uuid
  /// Optional Level-3 Topic child category.
  childCategoryId  String?          @map("child_category_id") @db.Uuid
  sourceSerial     String?          @map("source_serial") @db.VarChar(32)
  questionText     String           @map("question_text")
  /// Excel `পরীক্ষার নাম ও সাল`.
  examLabel        String?          @map("exam_label") @db.VarChar(240)
  optionA          String           @default("") @map("option_a")
  optionB          String           @default("") @map("option_b")
  optionC          String           @default("") @map("option_c")
  optionD          String           @default("") @map("option_d")
  /// Normalized key a|b|c|d when parseable; null when blank/unrecognized (still imported).
  correctKey       String?          @map("correct_key") @db.VarChar(1)
  /// Resolved option text for correctKey (nullable).
  correctAnswer    String?          @map("correct_answer")
  sortOrder        Int              @default(0) @map("sort_order")
  rowNumber        Int              @map("row_number")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch         TopicUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  category      Category         @relation("TopicQuestionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Category         @relation("TopicQuestionSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  childCategory Category?        @relation("TopicQuestionChildCategory", fields: [childCategoryId], references: [id], onDelete: Restrict)

  @@index([subcategoryId, sortOrder, id])
  @@index([childCategoryId, sortOrder, id])
  @@index([categoryId, subcategoryId])
  @@index([batchId, rowNumber])
  @@map("topic_questions")
}
