// Your Academy — PostgreSQL schema (source of truth via migrations)
// See docs/05-database-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Isolates Preliminary vs Written Question Bank taxonomies (DEC-041).
enum CategoryScope {
  PRELIMINARY
  WRITTEN
  /// Topic Base Question Analysis taxonomy (DEC-042).
  TOPIC
}

enum DocumentVisibility {
  PUBLIC
  AUTHENTICATED
  PREMIUM
}

/// Singleton homepage CMS rows: one DRAFT + one PUBLISHED (DEC-038).
enum HomepageContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaResourceType {
  IMAGE
  RAW
  VIDEO
  AUTO
}

enum MediaDeliveryType {
  UPLOAD
  PRIVATE
  AUTHENTICATED
}

enum BrowsingSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Practice / quiz / model-test products (DEC-023).
enum PracticeSetKind {
  DAILY_QUIZ
  SUBJECT_QUIZ
  TOPIC_QUIZ
  MODEL_TEST
  PREVIOUS_YEAR_SET
}

enum PracticeSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PracticeAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// Admin Excel/CSV bulk upload lifecycle (DEC-024).
enum QuestionUploadStatus {
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  ARCHIVED
}

enum QuestionImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
}

/// Learner platform events for admin activity analytics (Phase 1). No secrets.
enum LearningActivityType {
  LOGIN
  LOGOUT
  QUESTION_ATTEMPT
  PRACTICE_START
  PRACTICE_SUBMIT
  BOOKMARK_QUESTION
  BOOKMARK_DOCUMENT
  DOCUMENT_VIEW
}

/// DEC-029 — Support messaging
enum SupportConversationStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum SupportSenderType {
  USER
  GUEST
  ADMIN
  SYSTEM
}

enum SupportMessageKind {
  TEXT
  ATTACHMENT
  SYSTEM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(120)
  whatsappNumber String     @unique @map("whatsapp_number") @db.VarChar(32)
  email          String?    @unique @db.VarChar(255)
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  avatarAssetId  String?    @unique @map("avatar_asset_id") @db.Uuid
  trialStartedAt DateTime   @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt    DateTime   @map("trial_ends_at") @db.Timestamptz(3)
  /// Root category IDs chosen during onboarding (max 3 enforced in service).
  preferredCategoryIds String[]  @default([]) @map("preferred_category_ids") @db.Uuid
  lastQuestionId       String?   @map("last_question_id") @db.Uuid
  lastQuestionFilterQs String?   @map("last_question_filter_qs") @db.VarChar(512)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  avatarAsset         MediaAsset?         @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  uploadedAssets      MediaAsset[]        @relation("UploadedBy")
  authSessions        AuthSession[]
  createdQuestions    Question[]          @relation("QuestionCreator")
  createdWrittenQuestions WrittenQuestion[] @relation("WrittenQuestionCreator")
  lastQuestion        Question?           @relation("UserLastQuestion", fields: [lastQuestionId], references: [id], onDelete: SetNull)
  questionBookmarks   QuestionBookmark[]
  documentBookmarks   DocumentBookmark[]
  bookmarkCollections BookmarkCollection[]
  questionAttempts    QuestionAttempt[]
  practiceAttempts    PracticeAttempt[]
  createdPracticeSets PracticeSet[]       @relation("PracticeSetCreator")
  createdExams        Exam[]              @relation("ExamCreator")
  createdModelTests   ModelTest[]         @relation("ModelTestCreator")
  examAttempts        ExamAttempt[]
  modelTestAttempts   ModelTestAttempt[]
  modelTestGuideUpdates ModelTestGuideConfig[] @relation("ModelTestGuideUpdater")
  examGuideUpdates      ExamGuideConfig[]      @relation("ExamGuideUpdater")
  questionUploadBatches QuestionUploadBatch[]
  writtenUploadBatches  WrittenUploadBatch[]
  topicUploadBatches    TopicUploadBatch[]
  browsingSessions    BrowsingSession[]
  subscriptions       UserSubscription[]
  createdNews         News[]              @relation("NewsCreator")
  createdDocuments    Document[]          @relation("DocumentCreator")
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  learningActivityEvents LearningActivityEvent[]
  supportConversationsAsUser   SupportConversation[] @relation("SupportConversationUser")
  supportConversationsAssigned SupportConversation[] @relation("SupportConversationAssignee")
  supportMessagesSent          SupportMessage[]      @relation("SupportMessageSender")
  supportInternalNotes         SupportInternalNote[]
  linkedSupportGuestSessions   SupportGuestSession[] @relation("SupportGuestLinkedUser")
  homepageContentUpdates       HomepageContent[]     @relation("HomepageContentUpdater")
  homepageRevisions            HomepageRevision[]    @relation("HomepageRevisionCreator")

  @@index([status])
  @@index([trialEndsAt])
  @@index([createdAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash")
  familyId             String    @map("family_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId  String?   @map("replaced_by_session_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  slug        String        @db.VarChar(140)
  description String?
  parentId    String?       @map("parent_id") @db.Uuid
  /// PRELIMINARY = Preli/MCQ bank; WRITTEN = Written Question Bank; TOPIC = Topic Base (DEC-041/042).
  scope       CategoryScope @default(PRELIMINARY)
  /// Optional homepage / directory icon key (HomepageIconKey), mainly for TOPIC subcategories.
  iconKey     String?       @map("icon_key") @db.VarChar(40)
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]     @relation("CategoryTree")
  questions        Question[]     @relation("QuestionCategory")
  subQuestions     Question[]     @relation("QuestionSubcategory")
  writtenQuestions WrittenQuestion[] @relation("WrittenQuestionCategory")
  writtenSubQuestions WrittenQuestion[] @relation("WrittenQuestionSubcategory")
  topicQuestions      TopicQuestion[] @relation("TopicQuestionCategory")
  topicSubQuestions   TopicQuestion[] @relation("TopicQuestionSubcategory")
  topicChildQuestions TopicQuestion[] @relation("TopicQuestionChildCategory")
  topicBatchesAsCategory    TopicUploadBatch[] @relation("TopicBatchCategory")
  topicBatchesAsSubcategory TopicUploadBatch[] @relation("TopicBatchSubcategory")
  topicBatchesAsChildCategory TopicUploadBatch[] @relation("TopicBatchChildCategory")
  documents        Document[]
  attempts         QuestionAttempt[]
  practiceSets     PracticeSet[]  @relation("PracticeSetCategory")
  practiceSetTopics PracticeSet[] @relation("PracticeSetSubcategory")
  batchPlacementsAsCategory    QuestionUploadBatchPlacement[] @relation("BatchPlacementCategory")
  batchPlacementsAsSubcategory QuestionUploadBatchPlacement[] @relation("BatchPlacementSubcategory")
  writtenBatchPlacementsAsCategory    WrittenUploadBatchPlacement[] @relation("WrittenBatchPlacementCategory")
  writtenBatchPlacementsAsSubcategory WrittenUploadBatchPlacement[] @relation("WrittenBatchPlacementSubcategory")

  @@unique([scope, slug])
  @@index([parentId])
  @@index([scope, parentId])
  @@index([scope, isActive])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  title          String         @db.VarChar(200)
  content        String
  explanation    String?
  categoryId     String         @map("category_id") @db.Uuid
  subcategoryId  String?        @map("subcategory_id") @db.Uuid
  difficulty     Difficulty     @default(MEDIUM)
  status         QuestionStatus @default(DRAFT)
  /// Govt-job track tags (e.g. bcs-prelim, bank, primary-teacher). Not real PYQ unless marked.
  examTags       String[]       @default([]) @map("exam_tags")
  /// Optional human-readable source note (e.g. "Demo — BCS-style practice").
  sourceNote     String?        @map("source_note") @db.VarChar(240)
  /// Excel `প্রশ্ন নং` / serial from the upload sheet.
  sourceSerial   String?        @map("source_serial") @db.VarChar(32)
  /// Exam year extracted from sheet / derived from questionDate (public year filters).
  examYear       String?        @map("exam_year") @db.VarChar(16)
  /// Actual exam / question date set by admin (sort + year filter source of truth).
  questionDate   DateTime?      @map("question_date") @db.Timestamptz(3)
  /// Section heading that preceded this MCQ in the Excel sheet (first-column preamble rows).
  sectionTitle   String?        @map("section_title") @db.VarChar(500)
  /// SHA-256 of normalized question text + correct answer content (informational; duplicates allowed since 2026-11-17).
  contentHash    String?        @map("content_hash") @db.VarChar(64)
  uploadBatchId  String?        @map("upload_batch_id") @db.Uuid
  imageAssetId   String?        @map("image_asset_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  category    Category          @relation("QuestionCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category?         @relation("QuestionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  imageAsset  MediaAsset?       @relation("QuestionImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  uploadBatch QuestionUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  lastOpenedBy User[]           @relation("UserLastQuestion")
  options     QuestionOption[]
  bookmarks   QuestionBookmark[]
  attempts    QuestionAttempt[]
  practiceItems PracticeSetItem[]
  practiceAnswers PracticeAttemptAnswer[]
  importRows  QuestionImportRow[] @relation("ImportRowCreatedQuestion")

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId, status])
  @@index([subcategoryId, status])
  @@index([difficulty, status])
  @@index([examYear, status])
  @@index([status, questionDate(sort: Desc), id(sort: Desc)])
  @@index([questionDate(sort: Desc), status])
  @@index([examTags], type: Gin)
  @@index([contentHash])
  @@index([uploadBatchId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String  @db.VarChar(10)
  content    String
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  question              Question                 @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts              QuestionAttempt[]
  practiceAttemptAnswers PracticeAttemptAnswer[]

  @@index([questionId, sortOrder])
  /// Partial unique (migration): one is_correct=true row per question_id
  @@map("question_options")
}

/// Learner practice check — server stores correctness for personal analytics (DEC-022).
model QuestionAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String   @map("selected_option_id") @db.Uuid
  isCorrect        Boolean  @map("is_correct")
  categoryId       String   @map("category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, questionId, createdAt(sort: Desc)])
  @@map("question_attempts")
}

model News {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(200)
  slug         String    @unique @db.VarChar(220)
  summary      String?
  body         String
  coverAssetId String?   @map("cover_asset_id") @db.Uuid
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  coverAsset MediaAsset?    @relation("NewsCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("NewsCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents  NewsDocument[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("news")
}

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  title        String             @db.VarChar(200)
  description  String?
  mediaAssetId String             @map("media_asset_id") @db.Uuid
  categoryId   String?            @map("category_id") @db.Uuid
  visibility   DocumentVisibility @default(AUTHENTICATED)
  isPublished  Boolean            @default(false) @map("is_published")
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(3)

  mediaAsset MediaAsset         @relation("DocumentFile", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  newsLinks  NewsDocument[]
  bookmarks  DocumentBookmark[]

  @@index([isPublished])
  @@index([visibility])
  @@index([isPublished, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("documents")
}

model NewsDocument {
  newsId     String @map("news_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  news     News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([newsId, documentId])
  @@map("news_documents")
}

model MediaAsset {
  id               String            @id @default(uuid()) @db.Uuid
  publicId         String            @map("public_id") @db.VarChar(255)
  resourceType     MediaResourceType @map("resource_type")
  deliveryType     MediaDeliveryType @map("delivery_type")
  format           String?           @db.VarChar(32)
  bytes            Int
  mimeType         String            @map("mime_type") @db.VarChar(127)
  width            Int?
  height           Int?
  originalFilename String?           @map("original_filename") @db.VarChar(255)
  uploadedById     String?           @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  uploadedBy         User?               @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  userAvatar         User?               @relation("UserAvatar")
  questionImages     Question[]          @relation("QuestionImage")
  newsCovers         News[]              @relation("NewsCover")
  documents          Document[]          @relation("DocumentFile")
  supportAttachments SupportAttachment[]
  homepageHeroImages HomepageContent[]   @relation("HomepageHeroImage")

  @@unique([publicId, resourceType])
  @@index([uploadedById])
  @@map("media_assets")
}

/// Marketing homepage CMS document (DEC-038). Exactly one DRAFT and one PUBLISHED row.
model HomepageContent {
  id               String                 @id @default(uuid()) @db.Uuid
  status           HomepageContentStatus  @unique
  payload          Json
  heroImageAssetId String?                @map("hero_image_asset_id") @db.Uuid
  publishedAt      DateTime?              @map("published_at") @db.Timestamptz(3)
  updatedById      String?                @map("updated_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  heroImage MediaAsset? @relation("HomepageHeroImage", fields: [heroImageAssetId], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("HomepageContentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([heroImageAssetId])
  @@map("homepage_content")
}

/// Snapshot of published homepage payload for restore (DEC-038).
model HomepageRevision {
  id               String   @id @default(uuid()) @db.Uuid
  payload          Json
  heroImageAssetId String?  @map("hero_image_asset_id") @db.Uuid
  note             String?  @db.VarChar(200)
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User? @relation("HomepageRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("homepage_revisions")
}

/// Learner-owned MCQ save folder (Facebook-style collection). Private per user.
model BookmarkCollection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks QuestionBookmark[]

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmark_collections")
}

model QuestionBookmark {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  /// Null = Saved Items (uncategorized). At most one folder per user+question (DEC-026).
  collectionId String?  @map("collection_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  collection BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, collectionId, createdAt(sort: Desc)])
  @@index([collectionId])
  @@map("question_bookmarks")
}

model DocumentBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("document_bookmarks")
}

model BrowsingSession {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  startedAt        DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt  DateTime              @default(now()) @map("last_heartbeat_at") @db.Timestamptz(3)
  endedAt          DateTime?             @map("ended_at") @db.Timestamptz(3)
  accruedSeconds   Int                   @default(0) @map("accrued_seconds")
  clientInstanceId String?               @map("client_instance_id") @db.VarChar(64)
  userAgent        String?               @map("user_agent")
  status           BrowsingSessionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([status, lastHeartbeatAt(sort: Desc)])
  /// Partial unique (migration): one ACTIVE session per user_id
  @@map("browsing_sessions")
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(64)
  name          String   @db.VarChar(120)
  description   String?
  durationDays  Int      @map("duration_days")
  priceCents    Int      @default(0) @map("price_cents")
  currency      String   @default("USD") @db.Char(3)
  entitlements  Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  planId     String             @map("plan_id") @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime           @map("ends_at") @db.Timestamptz(3)
  canceledAt DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

