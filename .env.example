# =============================================================================
# Your Academy — environment template
# Copy:  cp .env.example .env
# Never commit real secrets. Only this example file is safe for git.
# =============================================================================

# Leave unset for Next.js builds (next build requires NODE_ENV=production).
# Nest/local scripts default to development when unset.
# NODE_ENV=development
APP_NAME=your-academy
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL
# Host apps use localhost. Docker Compose overrides host to "postgres".
# -----------------------------------------------------------------------------
POSTGRES_USER=your_academy
POSTGRES_PASSWORD=your_academy_dev_password
POSTGRES_DB=your_academy
POSTGRES_PORT=5432

# Used by Prisma / Nest when running on the host machine
DATABASE_URL=postgresql://your_academy:your_academy_dev_password@localhost:5432/your_academy?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ)
# Host apps: localhost. Docker services: redis hostname (set in compose).
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=5000
API_PUBLIC_URL=http://localhost:5000
# Comma-separated allowlist (local + optional tunnel/preview hosts)
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
SWAGGER_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Question/exam content requests per user (or guest IP) per 10 minutes (anti-scraping, DEC-055)
CONTENT_RATE_LIMIT_PER_10_MIN=300
# Express trust-proxy setting; default trusts private ranges (nginx in Docker)
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Real client IP header from the edge, only if the origin accepts nothing but Cloudflare
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# One device at a time (DEC-053): learners always; staff only when true
SINGLE_SESSION_STAFF=false
# SINGLE_SESSION_ENABLED=true
# Optional local directory for admin Excel import originals (DEC-024)
# QUESTION_IMPORT_DIR=/var/lib/your-academy/question-imports

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# Same-origin /api/v1 via Next rewrite → API_INTERNAL_URL
# -----------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://localhost:5000
# Socket.IO support chat (DEC-029). Leave empty to use same-origin /socket.io (Next rewrite → API).
# Only set this if the browser must talk to the API origin directly.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token
# Support WhatsApp (digits with country code, e.g. 8801XXXXXXXXX) for "forgot password, no email" help
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Footer social URLs: manage in Admin → Social media links (DEC-046). Not env-based.

# -----------------------------------------------------------------------------
# Cloudinary (server only)
# Placeholders below are rejected by StorageService.isConfigured().
# Replace with real credentials to enable signed upload + PDF download.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo_secret_change_me
CLOUDINARY_FOLDER_PREFIX=your-academy

# -----------------------------------------------------------------------------
# Email (API enqueues; worker sends via SMTP) — see docs/23-email-deliverability.md
# Local: Mailhog on :1025, or leave SMTP_HOST empty to log links (dev only).
# Production (Resend):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx (API key)
#   EMAIL_FROM="Your Academy <support@youracademy.com.bd>"
#   EMAIL_REPLY_TO=support@youracademy.com.bd
# Never send from a personal Gmail address — it lands in spam (DEC-050).
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true          # optional; defaults to true on port 465
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Your Academy <no-reply@your-academy.local>"
EMAIL_REPLY_TO=
# Footer "Need help?" address; defaults to EMAIL_REPLY_TO.
# EMAIL_SUPPORT_ADDRESS=
# Public site used for the email logo (/images/email-logo.png), footer links and payment
# result redirects; defaults to WEB_ORIGIN.
# APP_PUBLIC_URL=https://youracademy.com.bd
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
# Reset links: single-use, stored hashed. 30 minutes (DEC-048).
PASSWORD_RESET_TTL_SECONDS=1800
# Admin-assisted resets allowed per user per 15 minutes (DEC-054)
ADMIN_RESET_LIMIT_PER_USER=5
# Email confirmation links (Account Settings). Base defaults to ${WEB_ORIGIN}/verify-email.
EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# SSLCommerz payments (DEC-060). Leave the store id/password empty to disable online
# payment: the Packages page then says "payment not configured" (nothing crashes).
# SSLCZ_IS_LIVE=false → sandbox.sslcommerz.com, true → securepay.sslcommerz.com.
# The gateway posts back to ${API_PUBLIC_URL}/api/v1/payments/sslcommerz/{success,fail,cancel,ipn}
# — so API_PUBLIC_URL must be the public https origin in production.
# -----------------------------------------------------------------------------
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
# Gateway HTTP timeout (ms)
# SSLCZ_TIMEOUT_MS=30000
# Learners return to APP_PUBLIC_URL (see Email section) or the first WEB_ORIGIN after paying.
# Lost-IPN safety net: every N minutes, ask SSLCommerz about PENDING orders older than M minutes
# PAYMENT_RECHECK_ENABLED=true
# PAYMENT_RECHECK_INTERVAL_MINUTES=10
# PAYMENT_RECHECK_MIN_AGE_MINUTES=15
# DEC-062 — plan-expiry reminder emails (7 and 3 days before the end date)
# SUBSCRIPTION_REMINDERS_ENABLED=true
# SUBSCRIPTION_REMINDER_INTERVAL_MINUTES=60
# PENDING orders with no transaction at the gateway after this many minutes → FAILED (min 30)
# PAYMENT_PENDING_EXPIRE_MINUTES=120

# -----------------------------------------------------------------------------
# First dashboard admin: `pnpm admin:create` (also used by `pnpm db:seed`).
# Change the password before real use; admin:create refuses the example one in production.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_WHATSAPP=+8801000000000
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123
BOOTSTRAP_ADMIN_EMAIL=admin@your-academy.local

# -----------------------------------------------------------------------------
# Docker / Nginx (optional)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Production (.env.production on the VPS — chmod 600, never commit)
# Copy this file to .env.production and set real values before `pnpm docker:prod`.
# -----------------------------------------------------------------------------
# NODE_ENV=production
# COOKIE_SECURE=true
# SWAGGER_ENABLED=false
# WEB_ORIGIN=https://your.domain
# API_PUBLIC_URL=https://your.domain
# PASSWORD_RESET_URL_BASE=https://your.domain/reset-password
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# TLS_CERTS_DIR=/etc/your-academy/certs
# CERTBOT_WWW_DIR=/var/www/certbot
# JWT_ACCESS_SECRET=replace-with-long-random-secret-min-32-chars
# POSTGRES_PASSWORD=replace-with-strong-db-password
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Cloudflare API token + R2 S3 credentials (local .env only, never commit)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_S3_ENDPOINT=
# VPS deploy target (GitHub Actions DEPLOY_HOST / SSH)
# DEPLOY_HOST=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Your Academy <support@youracademy.com.bd>"
