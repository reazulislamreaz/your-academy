# =============================================================================
# Your Academy — environment template
# Copy:  cp .env.example .env
# Never commit real secrets. Only this example file is safe for git.
# =============================================================================

# Leave unset for Next.js builds (next build requires NODE_ENV=production).
# Nest/local scripts default to development when unset.
# NODE_ENV=development
APP_NAME=your-academy
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL
# Host apps use localhost. Docker Compose overrides host to "postgres".
# -----------------------------------------------------------------------------
POSTGRES_USER=your_academy
POSTGRES_PASSWORD=your_academy_dev_password
POSTGRES_DB=your_academy
POSTGRES_PORT=5432

# Used by Prisma / Nest when running on the host machine
DATABASE_URL=postgresql://your_academy:your_academy_dev_password@localhost:5432/your_academy?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ)
# Host apps: localhost. Docker services: redis hostname (set in compose).
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
TRIAL_DAYS=7
SWAGGER_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# Same-origin /api/v1 via Next rewrite → API_INTERNAL_URL
# -----------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token

# -----------------------------------------------------------------------------
# Cloudinary (server only)
# Placeholders below are rejected by StorageService.isConfigured().
# Replace with real credentials to enable signed upload + PDF download.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo_secret_change_me
CLOUDINARY_FOLDER_PREFIX=your-academy

# -----------------------------------------------------------------------------
# Email (password reset — API enqueues; worker sends via SMTP)
# Leave SMTP_HOST empty to log reset URLs in the worker instead of sending.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=noreply@your-academy.local
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Seed admin (pnpm db:seed)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_WHATSAPP=+8801000000000
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123
BOOTSTRAP_ADMIN_EMAIL=admin@your-academy.local

# -----------------------------------------------------------------------------
# Docker / Nginx (optional)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=8080
