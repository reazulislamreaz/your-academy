# Copy to .env for local Docker / app development. Never commit real secrets.

NODE_ENV=development
APP_NAME=your-academy
LOG_LEVEL=debug

# PostgreSQL (Compose)
POSTGRES_USER=your_academy
POSTGRES_PASSWORD=your_academy_dev_password
POSTGRES_DB=your_academy
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Database (API/worker — host-side use localhost; in Compose use postgres hostname)
DATABASE_URL=postgresql://your_academy:your_academy_dev_password@localhost:5432/your_academy?schema=public

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
TRIAL_DAYS=7
SWAGGER_ENABLED=true

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
PORT=3000

# Cloudinary (server only — placeholders)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER_PREFIX=your-academy

# Email (password reset — use Mailhog/Ethereal in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@your-academy.local
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_SECONDS=3600

# Admin bootstrap (Phase 2+)
BOOTSTRAP_ADMIN_WHATSAPP=+8801000000000
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123
