{
  "name": "your-academy",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:frontend": "dotenv -e .env -- turbo run dev --filter=@your-academy/frontend",
    "dev:backend": "dotenv -e .env -- turbo run dev --filter=@your-academy/backend",
    "dev:worker": "dotenv -e .env -- turbo run dev --filter=@your-academy/worker",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "dotenv -e .env -- turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml --env-file .env up -d postgres redis",
    "docker:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml --env-file .env up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml --env-file .env down",
    "db:generate": "dotenv -e .env -- pnpm --filter @your-academy/backend prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @your-academy/backend prisma:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @your-academy/backend prisma:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @your-academy/backend prisma:seed",
    "db:reset": "dotenv -e .env -- pnpm --filter @your-academy/backend exec prisma migrate reset --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
