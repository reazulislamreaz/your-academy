# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Environment / secrets — NEVER commit real credentials
# Only `.env.example` (placeholders) is allowed in git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Common secret filenames
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
secrets/
.secrets/

# DB dumps (pnpm db:backup)
backups/

# Local admin Excel import originals (DEC-024)
backend/storage/
storage/

# Logs / coverage
logs/
*.log
coverage/
.nyc_output/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Turbo / tooling
.turbo/
.eslintcache

# Accidental HOME=/…/frontend corepack caches (wrong HOME during local tooling)
**/200/

# Docker volumes / local data
docker/data/
docker/certs/*.pem
docker/certs/*.key
docker/certbot-www/
!docker/certs/README.md

# Database dumps
*.sql.gz
*.dump
